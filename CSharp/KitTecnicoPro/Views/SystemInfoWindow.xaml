<Window x:Class="KitTecnicoPro.Views.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🖥️ Informações do Sistema"
        Width="600" Height="640"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"

        Background="#0D1117"
        Loaded="Window_Loaded">



    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="🖥️ Informações do Sistema" FontSize="16" FontWeight="Bold" Foreground="#90CAF9"/>
                <TextBlock x:Name="TxtAtualizado" FontSize="10" Foreground="#546E7A" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔄 Atualizar" Click="OnRefreshClick"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#78909C" Padding="8,4" Margin="0,0,4,0"/>
                <Button Content="📋 Copiar" Click="OnCopyClick"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#0D1117" BorderBrush="#1565C0" Padding="10,4"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="InfoPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Fechar" IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#90A4AE"/>
        </StackPanel>
    </Grid>
</Window>


