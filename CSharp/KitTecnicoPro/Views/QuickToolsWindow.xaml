<Window x:Class="KitTecnicoPro.Views.QuickToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="⚡ Ferramentas Rápidas do Windows"
        Height="660" Width="860"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"

        Background="#0D1117">



    <Window.Resources>

        <Style x:Key="QBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Width"      Value="170"/>
            <Setter Property="Height"     Value="56"/>
            <Setter Property="Margin"     Value="5"/>
            <Setter Property="Padding"    Value="10,6"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#78909C"/>
            <Setter Property="Margin"     Value="5,14,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#0D1117" Padding="18,12">
            <StackPanel>
                <TextBlock Text="⚡ Ferramentas Rápidas do Windows"
                           FontSize="16" FontWeight="Bold" Foreground="#ECEFF1"/>
                <TextBlock Text="Acesso rápido a ferramentas administrativas do sistema"
                           FontSize="11" Foreground="#546E7A" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Conteúdo com scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,8">
            <StackPanel>

                <!-- ── SISTEMA ──────────────────────────────────────── -->
                <TextBlock Text="🖥️  SISTEMA" Style="{StaticResource SectionTitle}"/>
                <WrapPanel>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#0D47A1"
                            Tag="taskmgr" Click="OnLaunch">
                        <StackPanel><TextBlock Text="📊" FontSize="18"/><TextBlock Text="Gerenciador de Tarefas" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#0D47A1"
                            Tag="devmgmt.msc" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🔌" FontSize="18"/><TextBlock Text="Gerenciador de Dispositivos" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#0D47A1"
                            Tag="services.msc" Click="OnLaunch">
                        <StackPanel><TextBlock Text="⚙️" FontSize="18"/><TextBlock Text="Serviços do Windows" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#0D47A1"
                            Tag="msconfig" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🔧" FontSize="18"/><TextBlock Text="Configuração do Sistema" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#0D47A1"
                            Tag="regedit" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🗝️" FontSize="18"/><TextBlock Text="Editor de Registro" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#0D47A1"
                            Tag="gpedit.msc" Click="OnLaunch">
                        <StackPanel><TextBlock Text="📋" FontSize="18"/><TextBlock Text="Política de Grupo" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#0D47A1"
                            Tag="eventvwr.msc" Click="OnLaunch">
                        <StackPanel><TextBlock Text="📝" FontSize="18"/><TextBlock Text="Visualizador de Eventos" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#0D47A1"
                            Tag="secpol.msc" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🔒" FontSize="18"/><TextBlock Text="Política de Segurança" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                </WrapPanel>

                <!-- ── DISCO ──────────────────────────────────────────── -->
                <TextBlock Text="💾  DISCO &amp; ARMAZENAMENTO" Style="{StaticResource SectionTitle}"/>
                <WrapPanel>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#1B5E20"
                            Tag="diskmgmt.msc" Click="OnLaunch">
                        <StackPanel><TextBlock Text="💽" FontSize="18"/><TextBlock Text="Gerenciamento de Disco" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#1B5E20"
                            Tag="cleanmgr" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🧹" FontSize="18"/><TextBlock Text="Limpeza de Disco" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#1B5E20"
                            Tag="dfrgui" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🔄" FontSize="18"/><TextBlock Text="Desfragmentador" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#1B5E20"
                            Tag="__chkdsk" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🔍" FontSize="18"/><TextBlock Text="Verificar Disco (chkdsk)" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#1B5E20"
                            Tag="explorer shell:RecycleBinFolder" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🗑️" FontSize="18"/><TextBlock Text="Lixeira" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                </WrapPanel>

                <!-- ── REDE ──────────────────────────────────────────── -->
                <TextBlock Text="🌐  REDE &amp; INTERNET" Style="{StaticResource SectionTitle}"/>
                <WrapPanel>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#4A148C"
                            Tag="ncpa.cpl" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🔌" FontSize="18"/><TextBlock Text="Conexões de Rede" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#4A148C"
                            Tag="control.exe /name Microsoft.NetworkAndSharingCenter" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🌐" FontSize="18"/><TextBlock Text="Central de Rede" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#4A148C"
                            Tag="firewall.cpl" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🛡️" FontSize="18"/><TextBlock Text="Firewall do Windows" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#4A148C"
                            Tag="__ipconfig" Click="OnLaunch">
                        <StackPanel><TextBlock Text="📡" FontSize="18"/><TextBlock Text="ipconfig /all" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#4A148C"
                            Tag="__ping" Click="OnLaunch">
                        <StackPanel><TextBlock Text="📶" FontSize="18"/><TextBlock Text="Ping 8.8.8.8" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#4A148C"
                            Tag="__netstat" Click="OnLaunch">
                        <StackPanel><TextBlock Text="📊" FontSize="18"/><TextBlock Text="Netstat -an" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#4A148C"
                            Tag="__flushdns" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🔃" FontSize="18"/><TextBlock Text="Flush DNS" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                </WrapPanel>

                <!-- ── DIAGNÓSTICO ──────────────────────────────────── -->
                <TextBlock Text="🔎  DIAGNÓSTICO" Style="{StaticResource SectionTitle}"/>
                <WrapPanel>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#E65100"
                            Tag="msinfo32" Click="OnLaunch">
                        <StackPanel><TextBlock Text="ℹ️" FontSize="18"/><TextBlock Text="Informações do Sistema" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#E65100"
                            Tag="dxdiag" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🎮" FontSize="18"/><TextBlock Text="DiagDX (DirectX)" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#E65100"
                            Tag="perfmon" Click="OnLaunch">
                        <StackPanel><TextBlock Text="📈" FontSize="18"/><TextBlock Text="Monitor de Desempenho" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#E65100"
                            Tag="resmon" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🖥️" FontSize="18"/><TextBlock Text="Monitor de Recursos" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#E65100"
                            Tag="mdsched" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🧠" FontSize="18"/><TextBlock Text="Diagnóstico de Memória" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#E65100"
                            Tag="__sfc" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🔬" FontSize="18"/><TextBlock Text="sfc /scannow" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#E65100"
                            Tag="__dism" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🛠️" FontSize="18"/><TextBlock Text="DISM /RestoreHealth" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                </WrapPanel>

                <!-- ── PAINEL DE CONTROLE ──────────────────────────── -->
                <TextBlock Text="🎛️  PAINEL DE CONTROLE" Style="{StaticResource SectionTitle}"/>
                <WrapPanel>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#37474F"
                            Tag="control" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🎛️" FontSize="18"/><TextBlock Text="Painel de Controle" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#37474F"
                            Tag="appwiz.cpl" Click="OnLaunch">
                        <StackPanel><TextBlock Text="📦" FontSize="18"/><TextBlock Text="Programas e Recursos" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#37474F"
                            Tag="sysdm.cpl" Click="OnLaunch">
                        <StackPanel><TextBlock Text="⚙️" FontSize="18"/><TextBlock Text="Propriedades do Sistema" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#37474F"
                            Tag="powercfg.cpl" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🔋" FontSize="18"/><TextBlock Text="Energia" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#37474F"
                            Tag="timedate.cpl" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🕐" FontSize="18"/><TextBlock Text="Data e Hora" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#37474F"
                            Tag="intl.cpl" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🌍" FontSize="18"/><TextBlock Text="Região e Idioma" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#37474F"
                            Tag="__startup" Click="OnLaunch">
                        <StackPanel><TextBlock Text="🚀" FontSize="18"/><TextBlock Text="Inicialização (Startup)" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource QBtn}" Background="#0D1117" BorderBrush="#37474F"
                            Tag="rstrui" Click="OnLaunch">
                        <StackPanel><TextBlock Text="⏮️" FontSize="18"/><TextBlock Text="Restauração do Sistema" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                    </Button>
                </WrapPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#0D1117" Padding="14,8">
            <TextBlock x:Name="TxtStatus" Text="Clique em qualquer ferramenta para abrir"
                       Foreground="#546E7A" FontSize="11"/>
        </Border>
    </Grid>
</Window>


