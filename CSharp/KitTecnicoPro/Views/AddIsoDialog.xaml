<Window x:Class="KitTecnicoPro.Views.AddIsoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="💿 Adicionar ISO Personalizado"
        Height="560" Width="560"
        MinHeight="500" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0D1117">

    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#0D1117" Padding="20,14">
            <StackPanel>
                <TextBlock Text="💿 Adicionar ISO Personalizado"
                           FontSize="15" FontWeight="SemiBold" Foreground="#ECEFF1"/>
                <TextBlock Text="Preencha os dados do sistema operacional ou ferramenta"
                           FontSize="11" Foreground="#546E7A" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Formulário com scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,14,20,0">
            <StackPanel>

                <!-- Nome -->
                <TextBlock Text="Nome *" Foreground="#78909C" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNome"
                         materialDesign:HintAssist.Hint="Ex: Ubuntu Desktop, Kali Linux Live..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#ECEFF1" Margin="0,0,0,14"/>

                <!-- Versão + Arquitetura -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Versão" Foreground="#78909C" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtVersao"
                                 materialDesign:HintAssist.Hint="Ex: 24.04 LTS, 2024.4, latest"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="#ECEFF1" Margin="0,0,8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Arquitetura" Foreground="#78909C" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbArq"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Foreground="#ECEFF1" SelectedIndex="0">
                            <ComboBoxItem Content="x64"/>
                            <ComboBoxItem Content="x86"/>
                            <ComboBoxItem Content="ARM64"/>
                            <ComboBoxItem Content="ARM"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Categoria -->
                <TextBlock Text="Categoria *" Foreground="#78909C" FontSize="11" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbCategoria"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Foreground="#ECEFF1" Margin="0,0,0,14" SelectedIndex="0">
                    <ComboBoxItem Content="🪟 Windows"/>
                    <ComboBoxItem Content="🐧 Linux"/>
                    <ComboBoxItem Content="🐡 BSD"/>
                    <ComboBoxItem Content="🖥️ Outros"/>
                    <ComboBoxItem Content="🔧 Utilitários"/>
                </ComboBox>

                <!-- URL -->
                <TextBlock Text="URL *" Foreground="#78909C" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtUrl"
                         materialDesign:HintAssist.Hint="https://... (link direto .iso ou página de download)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#ECEFF1" Margin="0,0,0,6"
                         TextChanged="OnUrlChanged"/>
                <TextBlock x:Name="TxtUrlHint"
                           Text="💡 Se terminar em .iso será tratado como download direto"
                           Foreground="#94A3B8" FontSize="10" Margin="2,0,0,14"/>

                <!-- Tamanho + Link Direto -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tamanho estimado (MB)" Foreground="#78909C" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtTamanho"
                                 materialDesign:HintAssist.Hint="Ex: 4600"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Foreground="#ECEFF1" Margin="0,0,12,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <TextBlock Text="Download direto" Foreground="#78909C" FontSize="11" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ChkDirectLink"
                                  Content="⬇ Link .iso direto"
                                  Foreground="#90CAF9"
                                  IsChecked="False"/>
                    </StackPanel>
                </Grid>

                <!-- Descrição -->
                <TextBlock Text="Descrição (opcional)" Foreground="#78909C" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDescricao"
                         materialDesign:HintAssist.Hint="Breve descrição do sistema..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#ECEFF1" Margin="0,0,0,6"
                         MaxLength="120"/>

                <TextBlock x:Name="TxtErro" Foreground="#EF5350"
                           FontSize="12" Margin="0,4,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé com botões -->
        <Border Grid.Row="2" Background="#0D1117" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" Margin="0,0,10,0"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#94A3B8"/>
                <Button Content="💾  Adicionar ISO" IsDefault="True" Click="OnSaveClick"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#1D4ED8" BorderBrush="#2563EB" Foreground="White"
                        Padding="18,8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
