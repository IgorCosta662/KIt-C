<Window x:Class="KitTecnicoPro.Views.EventLogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="📋 Visualizador de Eventos"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"

        Background="#0D1117">



    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#0D1117" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="📋 Visualizador de Eventos Windows"
                               FontSize="16" FontWeight="Bold" Foreground="#ECEFF1"/>
                    <TextBlock x:Name="TxtResumo" FontSize="11" Foreground="#546E7A" Margin="0,3,0,0"
                               Text="Configure os filtros e clique em Carregar"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCarregar" Content="📋 Carregar Logs" Click="OnCarregarClick"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#0D1117" BorderBrush="#1B5E20"
                            Padding="14,8" FontSize="13" Margin="0,0,8,0"/>
                    <Button Content="📋 Exportar" Click="OnExportarClick"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#0D1117" BorderBrush="#1565C0"
                            Padding="12,8" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="#0D1117" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Log:" Foreground="#78909C" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbLog" Width="130" SelectedIndex="0"
                          Foreground="#ECEFF1" FontSize="12" Margin="0,0,14,0">
                    <ComboBoxItem Content="System"/>
                    <ComboBoxItem Content="Application"/>
                    <ComboBoxItem Content="Security"/>
                </ComboBox>
                <TextBlock Text="Nível:" Foreground="#78909C" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbNivel" Width="130" SelectedIndex="0"
                          Foreground="#ECEFF1" FontSize="12" Margin="0,0,14,0">
                    <ComboBoxItem Content="Todos"/>
                    <ComboBoxItem Content="Erro"/>
                    <ComboBoxItem Content="Aviso"/>
                    <ComboBoxItem Content="Informação"/>
                </ComboBox>
                <TextBlock Text="Últimas:" Foreground="#78909C" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbQtd" Width="100" SelectedIndex="1"
                          Foreground="#ECEFF1" FontSize="12" Margin="0,0,14,0">
                    <ComboBoxItem Content="100"/>
                    <ComboBoxItem Content="500"/>
                    <ComboBoxItem Content="1000"/>
                    <ComboBoxItem Content="2000"/>
                </ComboBox>
                <TextBox x:Name="TxtBusca" Width="200"
                         materialDesign:HintAssist.Hint="🔍 Filtrar por fonte/mensagem..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#ECEFF1" FontSize="12"
                         TextChanged="OnBuscaChanged"/>
            </StackPanel>
        </Border>

        <!-- Lista de Eventos -->
        <ListView x:Name="LstEventos" Grid.Row="2"
                  Background="#0D1117" BorderBrush="#1E3A5F"
                  Foreground="#ECEFF1"
                  VirtualizingPanel.IsVirtualizing="True"
                  SelectionChanged="OnEventoSelecionado">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="32"/>
                    <Setter Property="Foreground" Value="#ECEFF1"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1565C0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1E3A5F"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="45">
                        <GridViewColumn.Header><TextBlock Text="Nível" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NivelIcon}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="150">
                        <GridViewColumn.Header><TextBlock Text="Data/Hora" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataHora}" FontSize="11"
                                           Foreground="#78909C" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="60">
                        <GridViewColumn.Header><TextBlock Text="ID" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EventId}" FontSize="11"
                                           Foreground="#546E7A" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="180">
                        <GridViewColumn.Header><TextBlock Text="Fonte" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Fonte}" FontSize="11"
                                           Foreground="#90CAF9" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="340">
                        <GridViewColumn.Header><TextBlock Text="Mensagem" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MensagemCurta}" FontSize="11"
                                           Foreground="{Binding NivelColor}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Detalhe do evento selecionado -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#0D1117" Padding="8,5">
                <TextBlock Text="📄 Detalhe do evento selecionado:" Foreground="#78909C" FontSize="11"/>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#0D1117">
                <TextBox x:Name="TxtDetalhe" Background="#0D1117" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11"
                         Foreground="#90CAF9" IsReadOnly="True"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Padding="10,8"/>
            </ScrollViewer>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="4" Background="#0D1117" Padding="12,8">
            <TextBlock x:Name="TxtStatus" Foreground="#546E7A" FontSize="11"
                       Text="Selecione Log e Nível e clique em Carregar Logs"/>
        </Border>
    </Grid>
</Window>


