<Window x:Class="KitTecnicoPro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:KitTecnicoPro.Converters"
        mc:Ignorable="d"
        Title="Kit Técnico Pro"
        Height="650" Width="950"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CornerRadius="8" CaptionHeight="32" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:BoolToColorConverter       x:Key="BoolToColor"/>
        <converters:BoolToVisibilityConverter  x:Key="BoolToVis"/>
        <converters:InverseBoolConverter       x:Key="InvBool"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Paleta -->
        <SolidColorBrush x:Key="BgCard"      Color="#1C2438"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2A3A54"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F6FF"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#6B7FA3"/>

        <!-- Botão principal de instalação -->
        <Style x:Key="PrimaryBtn" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height"     Value="36"/>
            <Setter Property="Padding"    Value="16,0"/>
            <Setter Property="Margin"     Value="3,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="12.5"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
        </Style>

        <!-- Botão chip (ferramentas) -->
        <Style x:Key="ChipBtn" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height"      Value="28"/>
            <Setter Property="Padding"     Value="9,0"/>
            <Setter Property="Margin"      Value="2,2"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Foreground"  Value="#8BA7CC"/>
            <Setter Property="BorderBrush" Value="#2A3A54"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="14"/>
        </Style>

        <!-- Botão flat de gestão -->
        <Style x:Key="GestaoBtn" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height"    Value="28"/>
            <Setter Property="Padding"   Value="8,0"/>
            <Setter Property="Margin"    Value="1,2"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <!-- Card border -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background"        Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="CornerRadius"      Value="10"/>
            <Setter Property="Padding"           Value="0"/>
            <Setter Property="Margin"            Value="4"/>
        </Style>

        <Style x:Key="CatItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin"  Value="0,1"/>
        </Style>

        <!-- Cabeçalho de coluna -->
        <Style x:Key="ColHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background"      Value="#131C2E"/>
            <Setter Property="Foreground"      Value="#5A7A9A"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#2A3A54"/>
        </Style>
    </Window.Resources>

    <Grid Background="#70090D15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" BorderBrush="#1E2D47" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#080E1A" Offset="0"/>
                    <GradientStop Color="#0F1929" Offset="0.5"/>
                    <GradientStop Color="#080E1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1D4ED8" Offset="0"/>
                                <GradientStop Color="#0891B2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⚡" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="19" FontWeight="Bold" Foreground="#38BDF8"
                                   Text="Kit Técnico Pro"/>
                        <TextBlock Text="Pós-Formatação &amp; Manutenção de Sistemas"
                                   FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Contadores centrais -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="8" Padding="14,5"
                            Background="#12213A" BorderBrush="#1E3A60" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Apps" Width="15" Height="15"
                                                     Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#8BA7CC">
                                <Run FontWeight="Bold" FontSize="14" Foreground="#60CDFF"
                                     Text="{Binding FilteredApps.Count, Mode=OneWay}"/>
                                <Run Text=" de "/>
                                <Run FontWeight="Bold" FontSize="14" Foreground="#60CDFF"
                                     Text="{Binding AllApps.Count, Mode=OneWay}"/>
                                <Run Text=" programas"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Padding="14,5" Margin="8,0,0,0"
                            Background="#0F2A10" BorderBrush="#1A4D1C" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckboxMarked" Width="15" Height="15"
                                                     Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#8BA7CC">
                                <Run FontWeight="Bold" FontSize="14" Foreground="#4ADE80"
                                     Text="{Binding SelectedCount, Mode=OneWay}"/>
                                <Run Text=" selecionados"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Badges + botões -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Badge Internet — DataTrigger apenas (sem binding em Color) -->
                    <Border CornerRadius="20" Padding="10,4" Margin="3,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"  Value="#2D0E0E"/>
                                <Setter Property="BorderBrush" Value="#6B1F1F"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInternet}" Value="True">
                                        <Setter Property="Background"  Value="#0D2D12"/>
                                        <Setter Property="BorderBrush" Value="#1F6B2C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#F87171"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInternet}" Value="True">
                                                <Setter Property="Fill" Value="#4ADE80"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="Offline"/>
                                        <Setter Property="Foreground" Value="#F87171"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInternet}" Value="True">
                                                <Setter Property="Text"       Value="Online"/>
                                                <Setter Property="Foreground" Value="#4ADE80"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Badge Admin — DataTrigger -->
                    <Border CornerRadius="20" Padding="10,4" Margin="3,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"  Value="#2D1B0E"/>
                                <Setter Property="BorderBrush" Value="#6B3F1F"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="Background"  Value="#0D2D12"/>
                                        <Setter Property="BorderBrush" Value="#1F6B2C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Shield" Width="13" Height="13"
                                                     Margin="0,0,5,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                <Setter Property="Foreground" Value="#4ADE80"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text"       Value="Limitado"/>
                                        <Setter Property="Foreground" Value="#FBBF24"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                <Setter Property="Text"       Value="Administrador"/>
                                                <Setter Property="Foreground" Value="#4ADE80"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Badge Cache -->
                    <Border CornerRadius="20" Padding="10,4" Margin="3,0"
                            Background="#111C30" BorderBrush="#1E3050" BorderThickness="1"
                            ToolTip="Cache local de instaladores">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariant" Width="13" Height="13"
                                                     Foreground="#3B82F6" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="11" Foreground="#6B93CC">
                                <Run FontWeight="SemiBold" Foreground="#8BA7CC"
                                     Text="{Binding CacheSizeMB, StringFormat='{}{0:F1} MB'}"/>
                                <Run Text=" cache"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Separator Style="{StaticResource MaterialDesignDarkSeparator}" Margin="8,2" Background="#1E3A60" Width="1" Height="20" />

                    <!-- Atalhos de janela -->
                    <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Dashboard" Click="OnDashboardClick"
                            Width="34" Height="34" Foreground="#60CDFF">
                        <materialDesign:PackIcon Kind="ChartAreaspline" Width="18" Height="18"/>
                    </Button>
                    <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Informações do Sistema" Click="OnSystemInfoClick"
                            Width="34" Height="34" Foreground="#60CDFF">
                        <materialDesign:PackIcon Kind="Monitor" Width="18" Height="18"/>
                    </Button>
                    <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Plugins" Click="OnPluginsClick"
                            Width="34" Height="34" Foreground="#60CDFF">
                        <materialDesign:PackIcon Kind="Puzzle" Width="18" Height="18"/>
                    </Button>

                    <Separator Style="{StaticResource MaterialDesignDarkSeparator}" Margin="8,2" Background="#1E3A60" Width="1" Height="20" />

                    <!-- Controles da Janela -->
                    <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Minimizar" Click="OnMinimizeClick"
                            Width="34" Height="34" Foreground="#94A3B8">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16"/>
                    </Button>
                    <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Maximizar" Click="OnMaximizeClick"
                            Width="34" Height="34" Foreground="#94A3B8">
                        <materialDesign:PackIcon Kind="WindowMaximize" Width="16" Height="16"/>
                    </Button>
                    <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Fechar" Click="OnCloseClick"
                            Width="34" Height="34" Foreground="#F87171">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ TOOLBAR PRINCIPAL ════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#0F1929" Padding="12,7"
                BorderBrush="#1A2640" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Modo Paralelo -->
                <Border DockPanel.Dock="Right" CornerRadius="8" Background="#131E33"
                        BorderBrush="#1E3050" BorderThickness="1"
                        Padding="12,5" Margin="4,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding ParallelMode}" VerticalAlignment="Center"
                                  Margin="0,0,7,0" ToolTip="Instalar em paralelo"/>
                        <materialDesign:PackIcon Kind="Flash" Width="14" Height="14"
                                                 Foreground="#FBBF24" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Paralelo" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="x" FontSize="11" VerticalAlignment="Center" Foreground="#3D5070"/>
                        <TextBox Text="{Binding MaxParallel, UpdateSourceTrigger=LostFocus, TargetNullValue=3}"
                                 Width="30" FontSize="12" TextAlignment="Center" FontWeight="Bold"
                                 Background="Transparent" Foreground="#E2E8F0"
                                 BorderThickness="0" Padding="0" VerticalAlignment="Center" Margin="3,0"/>
                    </StackPanel>
                </Border>

                <!-- Botões de ação -->
                <WrapPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryBtn}"
                            Background="#1D4ED8" BorderBrush="#1D4ED8"
                            Command="{Binding InstallSelectedCommand}" IsEnabled="{Binding IsIdle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" Width="16" Height="16" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding SelectedCount, StringFormat='Instalar Selecionados ({0})'}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryBtn}"
                            Background="#15803D" BorderBrush="#15803D"
                            Command="{Binding InstallAllCommand}" IsEnabled="{Binding IsIdle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DownloadMultiple" Width="16" Height="16" Margin="0,0,7,0"/>
                            <TextBlock Text="Instalar Tudo"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryBtn}"
                            Background="#6D28D9" BorderBrush="#6D28D9"
                            Click="OnInstallProfileClick" IsEnabled="{Binding IsIdle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountBox" Width="16" Height="16" Margin="0,0,7,0"/>
                            <TextBlock Text="Instalar por Perfil"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryBtn}"
                            Background="#C2410C" BorderBrush="#C2410C"
                            Command="{Binding UpdateAllCommand}" IsEnabled="{Binding IsIdle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Update" Width="16" Height="16" Margin="0,0,7,0"/>
                            <TextBlock Text="Atualizar Tudo"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryBtn}"
                            Background="#991B1B" BorderBrush="#991B1B"
                            Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" Margin="0,0,7,0"/>
                            <TextBlock Text="Cancelar"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ═══ TOOLBAR DE FERRAMENTAS ═══════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#090F1C" Padding="10,5"
                BorderBrush="#141E32" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">

                    <!-- Grupo Sistema -->
                    <Border CornerRadius="8" Background="#101828" BorderBrush="#1A2A42"
                            BorderThickness="1" Padding="8,4" Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"><materialDesign:PackIcon Kind="Broom" Foreground="#4A6080" Margin="0,0,4,0"/><TextBlock Text="Sistema" Foreground="#4A6080" FontSize="10.5" FontWeight="Bold"/></StackPanel>
                            <Button Style="{StaticResource ChipBtn}"
                                    Command="{Binding CleanSystemCommand}" IsEnabled="{Binding IsIdle}"
                                    ToolTip="Limpar arquivos temporários">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Broom" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Limpeza"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipBtn}"
                                    Click="OnDriverBackupClick" IsEnabled="{Binding IsIdle}"
                                    ToolTip="Fazer backup de todos os drivers do Windows">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="HarddiskPlus" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Backup Drivers"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipBtn}"
                                    Click="OnOptimizeClick" IsEnabled="{Binding IsIdle}"
                                    ToolTip="Otimizar Windows">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Tune" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Otimizar"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Grupo Diagnóstico -->
                    <Border CornerRadius="8" Background="#101828" BorderBrush="#1A2A42"
                            BorderThickness="1" Padding="8,4" Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"><materialDesign:PackIcon Kind="Toolbox" Foreground="#4A6080" Margin="0,0,4,0"/><TextBlock Text="Diagnóstico" Foreground="#4A6080" FontSize="10.5" FontWeight="Bold"/></StackPanel>
                            <Button Style="{StaticResource ChipBtn}" Click="OnProcessManagerClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Memory" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Processos"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="OnSystemInfoClick" ToolTip="Ver Informações do Hardware e Sistema">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Info do Sistema"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="OnNetworkScannerClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Lan" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Rede"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="OnStartupManagerClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="RocketLaunch" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Inicialização"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="OnServiceManagerClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cog" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Serviços"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="OnEventLogClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardList" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Eventos"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Grupo Ferramentas -->
                    <Border CornerRadius="8" Background="#101828" BorderBrush="#1A2A42"
                            BorderThickness="1" Padding="8,4" Margin="0,2,8,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔧 Ferramentas" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#4A6080" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource ChipBtn}" Click="OnIsoManagerClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Disc" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="ISOs"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="OnQuickToolsClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Flash" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Atalhos"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="OnFileHasherClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Key" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Hash"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="OnCredentialVaultClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Safe" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Cofre"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="OnScriptsClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ScriptText" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Scripts PS"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ChipBtn}" Click="OnToolsClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Wrench" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Extras"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Grupo Gestão -->
                    <Border CornerRadius="8" Background="#101828" BorderBrush="#1A2A42"
                            BorderThickness="1" Padding="8,4" Margin="0,2,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️ Gestão" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#4A6080" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource GestaoBtn}" Click="OnAddAppClick"
                                    IsEnabled="{Binding IsIdle}" ToolTip="Novo app">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Novo App"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GestaoBtn}" Click="OnManageProfilesClick"
                                    IsEnabled="{Binding IsIdle}" ToolTip="Perfis">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountGroup" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Perfis"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GestaoBtn}"
                                    Command="{Binding CheckInstalledCommand}" IsEnabled="{Binding IsIdle}"
                                    ToolTip="Verificar instalados">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckCircle" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Verificar"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GestaoBtn}" Click="OnImportExportClick"
                                    IsEnabled="{Binding IsIdle}" ToolTip="Importar/Exportar">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExport" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Imp/Exp"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GestaoBtn}"
                                    Command="{Binding UpdateListOnlineCommand}" IsEnabled="{Binding IsIdle}"
                                    ToolTip="Sincronizar online">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CloudSync" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Sync"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GestaoBtn}"
                                    Command="{Binding ClearCacheCommand}" IsEnabled="{Binding IsIdle}"
                                    ToolTip="Limpar cache">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DeleteSweep" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Limpar Cache"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GestaoBtn}"
                                    Command="{Binding GenerateReportTxtCommand}" ToolTip="Relatório TXT">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocument" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text=".TXT"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GestaoBtn}"
                                    Command="{Binding GenerateReportHtmlCommand}" ToolTip="Relatório HTML">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CodeBraces" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text=".HTML"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ CONTEÚDO PRINCIPAL ═══════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="6,6,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="320">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="210"/>
                            <Setter Property="MinWidth" Value="160"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMenuExpanded}" Value="False">
                                    <Setter Property="Width" Value="65"/>
                                    <Setter Property="MinWidth" Value="65"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Categorias -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#111D30" CornerRadius="10,10,0,0" Padding="12,10">
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}"
                                    Width="24" Height="24" Padding="0" Command="{Binding ToggleMenuCommand}"
                                    Foreground="#60A5FA" ToolTip="Recolher/Expandir">
                                <materialDesign:PackIcon Kind="Menu" Width="18" Height="18"/>
                            </Button>
                            
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMenuExpanded}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <materialDesign:PackIcon Kind="FolderMultipleOutline" Width="16" Height="16"
                                                         Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Categorias" FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Separator Grid.Row="1" Background="#1E3050" Margin="0"/>
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             Background="Transparent" BorderThickness="0" Padding="6,6"
                             Style="{StaticResource MaterialDesignListBox}"
                             ItemContainerStyle="{StaticResource CatItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding}">
                                    <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16"
                                                             Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" FontSize="12.5" Margin="10,0,0,0"
                                               Foreground="#94A3B8" FontWeight="Medium" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsMenuExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE"/>

            <!-- Área central -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="180" MinHeight="100" MaxHeight="400"/>
                </Grid.RowDefinitions>

                <!-- Barra de busca -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#0C1626" CornerRadius="8" Margin="10,8"
                                Padding="10,4" BorderBrush="#1E3050" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center"
                                                         Margin="0,0,8,0" Foreground="#3B82F6" Width="18" Height="18"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignTextBox}"
                                         materialDesign:HintAssist.Hint="Buscar por nome, descrição ou categoria..."
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="{StaticResource TextPrimary}"
                                         FontSize="13" Padding="2,5"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button Style="{StaticResource GestaoBtn}"
                                    Command="{Binding SelectAllCommand}" IsEnabled="{Binding IsIdle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckAll" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Todos"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GestaoBtn}"
                                    Command="{Binding DeselectAllCommand}" IsEnabled="{Binding IsIdle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckboxBlankOutline" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Nenhum"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GestaoBtn}"
                                    Command="{Binding ClearSearchCommand}"
                                    ToolTip="Limpar busca">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Close" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Limpar"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Lista de apps e Estado Vazio -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" Margin="0,4,0,0">
                    <Grid>

        <!-- ══ Lista em Cards Modernos ══ -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,5,0,0">
            <ItemsControl x:Name="LstApps" ItemsSource="{Binding FilteredApps}" Margin="10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- CARD -->
                        <Border Width="330" Height="150" Margin="10,10" CornerRadius="12" Background="#80111C2B" BorderBrush="#1E2C44" BorderThickness="1"
                                materialDesign:ElevationAssist.Elevation="Dp4">
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Topo: Checkbox, Ícone, Nome, Status -->
                                <DockPanel Grid.Row="0" LastChildFill="False">
                                    <!-- Checkbox de Seleção -->
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"
                                              IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    
                                    <!-- Ícone do App -->
                                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1">
                                        <materialDesign:PackIcon Kind="{Binding AppIcon, Mode=OneWay}" Width="24" Height="24" Foreground="#60CDFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    
                                    <!-- Nome -->
                                    <StackPanel DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="150">
                                        <TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="Bold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Categoria}" FontSize="10" Foreground="#60CDFF" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    
                                    <!-- Status Badge -->
                                    <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,3" VerticalAlignment="Top" Background="{Binding StatusColor, Mode=OneWay}">
                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </DockPanel>

                                <!-- Meio: Descrição -->
                                <TextBlock Grid.Row="1" Text="{Binding Descricao}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"/>

                                <!-- Rodapé: Info e Ações -->
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <!-- Tags ID/Tipo -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Border CornerRadius="4" Background="#0D1E33" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Tipo}" FontSize="10" Foreground="#3B82F6" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#3D5070" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Ações do lado direito -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <!-- Play Rápido -->
                                        <Button Tag="{Binding}" Click="OnQuickInstallClick" Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28" Margin="0,0,4,0" ToolTip="Instalar agora"
                                                IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <materialDesign:PackIcon Kind="PlayCircle" Width="18" Height="18" Foreground="#22C55E"/>
                                        </Button>
                                        
                                        <!-- Pasta Setup -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="26" Height="26" Tag="{Binding}" Click="OnSetLocalPathClick"
                                                ToolTip="{Binding LocalPath, StringFormat='Setup: {0}', TargetNullValue='Vincular setup.exe local'}" Margin="0,0,2,0">
                                            <Grid>
                                                <materialDesign:PackIcon Kind="FolderOutline" Width="15" Height="15" Foreground="#3D5070" Visibility="{Binding HasLocalPath, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"/>
                                                <materialDesign:PackIcon Kind="FolderCheck" Width="15" Height="15" Foreground="#22C55E" Visibility="{Binding HasLocalPath, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Button>
                                        <!-- Baixar Offline -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="26" Height="26" Tag="{Binding}" Click="OnDownloadOfflineClick" ToolTip="Baixar Instalador Offline" Margin="0,0,2,0">
                                            <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="15" Height="15" Foreground="#A855F7"/>
                                        </Button>

                                        <!-- Editar -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="26" Height="26" Tag="{Binding}" Click="OnEditAppClick" ToolTip="Editar" Margin="0,0,2,0">
                                            <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" Foreground="#60A5FA"/>
                                        </Button>

                                        <!-- Remover -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}" Width="26" Height="26" Tag="{Binding}" Click="OnRemoveAppClick" ToolTip="Remover">
                                            <materialDesign:PackIcon Kind="TrashCan" Width="14" Height="14" Foreground="#F87171"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>


                    <!-- Estado Vazio (Nenhum resultado) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredApps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="Ghost" Width="72" Height="72"
                                                 Foreground="#3D5070" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nenhum programa encontrado" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#6B7FA3" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Tente buscar por outro nome ou limpar o filtro de categoria."
                                   FontSize="13" Foreground="#4A6080" HorizontalAlignment="Center"/>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding ClearSearchCommand}"
                                Content="Limpar Filtros" Width="140" Margin="0,20,0,0"
                                Foreground="#60CDFF" BorderBrush="#2A3A54"/>
                    </StackPanel>
                </Grid>
                </Border>

                <!-- Splitter vertical -->
                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                              Background="#1A2640" Cursor="SizeNS"/>

                <!-- Console de logs -->
                <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header do console -->
                        <Border Background="#0B1527" Padding="10,7" CornerRadius="10,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Ponto indicador IsBusy — DataTrigger -->
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#3D5070"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Fill" Value="#22C55E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <materialDesign:PackIcon Kind="Console" Width="15" Height="15"
                                                             Foreground="#3B82F6" Margin="0,0,7,0"/>
                                    <TextBlock Text="Console de Operações" FontWeight="Bold" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Margin="12,0,0,0" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                        <Run Text="⏳ "/>
                                        <Run Text="{Binding StatusText}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Width="26" Height="26" ToolTip="Abrir pasta de logs"
                                            Click="OnOpenLogFileClick">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14"
                                                                 Foreground="#3D5070"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Width="26" Height="26" ToolTip="Limpar console"
                                            Click="OnClearLogClick">
                                        <materialDesign:PackIcon Kind="TrashCan" Width="14" Height="14"
                                                                 Foreground="#3D5070"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Mensagens -->
                        <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer"
                                      VerticalScrollBarVisibility="Auto" Background="#07101C">
                            <ItemsControl ItemsSource="{Binding Logs}" x:Name="LogItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,2">
                                            <TextBlock FontSize="12" FontFamily="Consolas">
                                                <Run Text="{Binding FormattedTime, Mode=OneWay}" Foreground="#2C3E5A"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding LevelIcon, Mode=OneWay}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding Message}"
                                                     Foreground="{Binding LevelColor, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ STATUS BAR ════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#060C18"
                BorderBrush="#111E33" BorderThickness="0,1,0,0">
            <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="OnOpenV1Click"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        ToolTip="Abrir TechKit Pro v1.0"
                        Foreground="#2A3E60" FontSize="11" Padding="6,2" Height="24">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="History" Width="13" Height="13" Margin="0,0,4,0"/>
                        <TextBlock Text="v1.0"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="8,0">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="13" Height="13"
                                             Foreground="#1E3A60" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="#3D5B80" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}"
                               FontSize="11" FontWeight="SemiBold" Foreground="#3B82F6"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ProgressBar Value="{Binding Progress}" Maximum="100"
                                 Width="200" Height="6"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Overlay de carregamento -->
        <Grid Grid.Row="0" Grid.RowSpan="5"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
              Background="#88000000">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,70">
                <Border CornerRadius="12" Padding="20,14"
                        Background="#0F1D35" BorderBrush="#3B82F6" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     Width="24" Height="24" IsIndeterminate="True" Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <ProgressBar Value="{Binding Progress}" Maximum="100"
                                         Width="220" Height="4" Margin="0,5,0,0"
                                         Style="{StaticResource MaterialDesignLinearProgressBar}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Window>



