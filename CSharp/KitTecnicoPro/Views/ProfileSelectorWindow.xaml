<Window x:Class="KitTecnicoPro.Views.ProfileSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Selecionar Perfil"
        Width="400" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"

        Background="#0D1117">



    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="👤 Escolha um Perfil de Instalação" FontSize="15" FontWeight="Bold"
                   Foreground="#90CAF9" Margin="0,0,0,16"/>

        <ListBox Grid.Row="1" x:Name="ProfileList"
                 Background="#0D1117"
                 Style="{StaticResource MaterialDesignListBox}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#0D1117" CornerRadius="6" Padding="12,8" Margin="2">
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#ECEFF1">
                                <Run Text="{Binding Icone}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Nome}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Descricao}" FontSize="11"
                                       Foreground="#78909C" Margin="0,2,0,0"/>
                            <TextBlock FontSize="10" Foreground="#546E7A" Margin="0,2,0,0">
                                <Run Text="{Binding Apps.Count, Mode=OneWay}"/>
                                <Run Text=" programas"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="#90A4AE"/>
            <Button Content="Instalar Perfil" Click="OnConfirmClick"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#0D1117" BorderBrush="#4A148C"/>
        </StackPanel>
    </Grid>
</Window>


