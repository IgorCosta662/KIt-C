<Window x:Class="KitTecnicoPro.Views.ImportExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Importar / Exportar"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"

        Background="#0D1117">



    <StackPanel Margin="24">
        <TextBlock Text="📤 Importar / Exportar Apps" FontSize="16" FontWeight="Bold"
                   Foreground="#90CAF9" Margin="0,0,0,20"/>

        <Border Background="#0D1117" CornerRadius="6" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Exportar lista de apps" FontSize="13" FontWeight="SemiBold"
                           Foreground="#ECEFF1" Margin="0,0,0,6"/>
                <TextBlock Text="Salva o arquivo apps.json em um local de sua escolha."
                           FontSize="11" Foreground="#78909C" Margin="0,0,0,10"/>
                <Button Content="💾 Exportar apps.json" Click="OnExportClick"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#90CAF9" BorderBrush="#90CAF9"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <Border Background="#0D1117" CornerRadius="6" Padding="14" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Importar lista de apps" FontSize="13" FontWeight="SemiBold"
                           Foreground="#ECEFF1" Margin="0,0,0,6"/>
                <TextBlock Text="Carrega um arquivo apps.json externo (substitui a lista atual)."
                           FontSize="11" Foreground="#78909C" Margin="0,0,0,10"/>
                <Button Content="📂 Importar apps.json" Click="OnImportClick"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#A5D6A7" BorderBrush="#A5D6A7"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <Button Content="Fechar" IsCancel="True" HorizontalAlignment="Right"
                Style="{StaticResource MaterialDesignFlatButton}" Foreground="#90A4AE"/>
    </StackPanel>
</Window>


