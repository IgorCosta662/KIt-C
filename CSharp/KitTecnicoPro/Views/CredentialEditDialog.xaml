<Window x:Class="KitTecnicoPro.Views.CredentialEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🔐 Editar Credencial"
        Height="480" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🔐 Nova Credencial" x:Name="TxtTitle"
                   FontSize="15" FontWeight="Bold" Foreground="#90CAF9" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <ComboBox x:Name="CmbCat" Margin="0,0,0,14"
                      materialDesign:HintAssist.Hint="Categoria"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Foreground="#ECEFF1" FontSize="13">
                <ComboBoxItem Content="🖥️ RDP/SSH"/>
                <ComboBoxItem Content="📧 E-mail"/>
                <ComboBoxItem Content="🌐 Wi-Fi"/>
                <ComboBoxItem Content="🔑 Licença"/>
                <ComboBoxItem Content="💳 Conta"/>
                <ComboBoxItem Content="📝 Nota"/>
            </ComboBox>

            <TextBox x:Name="TxtTitulo" Margin="0,0,0,14"
                     materialDesign:HintAssist.Hint="Título *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Foreground="#ECEFF1" FontSize="13"/>

            <TextBox x:Name="TxtSubTitulo" Margin="0,0,0,14"
                     materialDesign:HintAssist.Hint="Host / URL / IP (opcional)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Foreground="#ECEFF1" FontSize="13"/>

            <TextBox x:Name="TxtUsuario" Margin="0,0,0,14"
                     materialDesign:HintAssist.Hint="Usuário / E-mail (opcional)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Foreground="#ECEFF1" FontSize="13"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PwdSenha"
                             materialDesign:HintAssist.Hint="Senha / Chave de licença (opcional)"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             Foreground="#ECEFF1" FontSize="13"/>
                <TextBox x:Name="TxtSenhaVisivel"
                         materialDesign:HintAssist.Hint="Senha / Chave de licença (opcional)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#ECEFF1" FontSize="13" Visibility="Collapsed"/>
                <Button Grid.Column="1" Content="👁" Click="OnToggleMostrarSenha"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#94A3B8" ToolTip="Mostrar/Ocultar senha"
                        Padding="8,0" Margin="6,0,0,0"/>
                <Button Grid.Column="2" Content="🎲" Click="OnGerarSenha"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#90CAF9" ToolTip="Gerar senha forte aleatória"
                        Padding="8,0" Margin="4,0,0,0"/>
            </Grid>

            <TextBox x:Name="TxtNotas" Margin="0,0,0,0"
                     materialDesign:HintAssist.Hint="Notas (opcional)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Foreground="#ECEFF1" FontSize="13"
                     AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="TxtErro" Foreground="#EF5350" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Cancelar" IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#90A4AE" Padding="14,8" Margin="0,0,8,0"/>
            <Button Content="💾 Salvar" Click="OnSalvarClick"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#1D4ED8" BorderBrush="#2563EB" Foreground="White" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
