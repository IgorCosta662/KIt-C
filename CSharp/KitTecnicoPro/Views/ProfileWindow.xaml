<Window x:Class="KitTecnicoPro.Views.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Gerenciar Perfis"
        Width="680" Height="520"
        WindowStartupLocation="CenterOwner"

        Background="#0D1117">



    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lista de perfis -->
        <Border Background="#0D1117" CornerRadius="8" Padding="8" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Perfis" FontWeight="SemiBold" FontSize="13"
                           Foreground="#90CAF9" Margin="4,0,0,8"/>

                <ListBox Grid.Row="1" x:Name="ProfileList"
                         Background="#0D1117"
                         Style="{StaticResource MaterialDesignListBox}"
                         SelectionChanged="ProfileList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="13" Padding="4,4" Foreground="#ECEFF1">
                                <Run Text="{Binding Icone}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Nome}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button Content="+ Novo Perfil" Click="OnNewProfileClick"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#90CAF9" BorderBrush="#90CAF9"
                            HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                    <Button Content="🗑 Excluir" Click="OnDeleteProfileClick"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#EF9A9A" BorderBrush="#EF9A9A"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Edição do perfil -->
        <Border Grid.Column="1" Background="#0D1117" CornerRadius="8" Padding="16">
            <Grid x:Name="EditorPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Editar Perfil" FontSize="14" FontWeight="Bold"
                           Foreground="#90CAF9" Margin="0,0,0,12"/>

                <TextBox Grid.Row="1" x:Name="TxtProfileName"
                         materialDesign:HintAssist.Hint="Nome do perfil"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#ECEFF1" Margin="0,0,0,8"/>

                <TextBox Grid.Row="2" x:Name="TxtProfileDesc"
                         materialDesign:HintAssist.Hint="Descrição"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#ECEFF1" Margin="0,0,0,8"/>

                <Border Grid.Row="3" Background="#0D1117" CornerRadius="4" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Programas incluídos (IDs winget, um por linha):"
                                   FontSize="11" Foreground="#78909C" Margin="8,6,0,4"/>
                        <TextBox Grid.Row="1" x:Name="TxtApps"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="12"
                                 Background="#0D1117" BorderThickness="0"
                                 Foreground="#A5D6A7"
                                 Padding="8" MinHeight="120"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Salvar Perfil" Click="OnSaveProfileClick"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#0D1117" BorderBrush="#1565C0" Margin="0,0,8,0"/>
                    <Button Content="Fechar" IsCancel="True"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#90A4AE"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>


