<Window x:Class="KitTecnicoPro.Views.CredentialVaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🔐 Cofre de Credenciais"
        Height="640" Width="980"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"

        Background="#0D1117">



    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#0D1117" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🔐 Cofre de Credenciais" FontSize="16" FontWeight="Bold" Foreground="#ECEFF1"/>
                    <TextBlock FontSize="11" Foreground="#546E7A" Margin="0,3,0,0"
                               Text="Armazena senhas, chaves de licença e anotações de forma criptografada (AES-256 via DPAPI)"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ Nova Entrada" Click="OnNovaClick"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#0D1117" BorderBrush="#1B5E20"
                            Padding="12,6" Margin="0,0,8,0"/>
                    <Button Content="🔄 Atualizar" Click="OnRefreshClick"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#0D1117" BorderBrush="#1565C0" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="#0D1117" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtBusca" Width="230"
                         materialDesign:HintAssist.Hint="🔍 Buscar..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#ECEFF1" FontSize="12" Margin="0,0,14,0"
                         TextChanged="OnBuscaChanged"/>
                <ComboBox x:Name="CmbCategoria" Width="140" SelectedIndex="0"
                          SelectionChanged="OnCatChanged"
                          Foreground="#ECEFF1" FontSize="12">
                    <ComboBoxItem Content="Todas"/>
                    <ComboBoxItem Content="🖥️ RDP/SSH"/>
                    <ComboBoxItem Content="📧 E-mail"/>
                    <ComboBoxItem Content="🌐 Wi-Fi"/>
                    <ComboBoxItem Content="🔑 Licença"/>
                    <ComboBoxItem Content="💳 Conta"/>
                    <ComboBoxItem Content="📝 Nota"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Lista -->
        <ListView x:Name="LstCredenciais" Grid.Row="2"
                  Background="#0D1117" BorderBrush="#1E3A5F"
                  Foreground="#ECEFF1"
                  VirtualizingPanel.IsVirtualizing="True"
                  SelectionChanged="OnSelectionChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="42"/>
                    <Setter Property="Foreground" Value="#ECEFF1"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1565C0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1E3A5F"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="50">
                        <GridViewColumn.Header><TextBlock Text="Cat." Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CatIcon}" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="200">
                        <GridViewColumn.Header><TextBlock Text="Título" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold" Foreground="#ECEFF1"/>
                                    <TextBlock Text="{Binding SubTitulo}" FontSize="10" Foreground="#546E7A"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="180">
                        <GridViewColumn.Header><TextBlock Text="Usuário / Host" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Usuario}" FontSize="12" Foreground="#90CAF9"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="170">
                        <GridViewColumn.Header><TextBlock Text="Senha / Chave" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSenha" Text="••••••••••••" FontSize="12"
                                               Foreground="#78909C" VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <Button Content="👁" Tag="{Binding}" Click="OnToggleSenha"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#546E7A" Padding="2,0" FontSize="13"
                                            ToolTip="Mostrar/ocultar"/>
                                    <Button Content="📋" Tag="{Binding}" Click="OnCopySenha"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#546E7A" Padding="2,0" FontSize="13"
                                            ToolTip="Copiar senha"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="200">
                        <GridViewColumn.Header><TextBlock Text="Notas" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Notas}" FontSize="11" Foreground="#546E7A"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="100">
                        <GridViewColumn.Header><TextBlock Text="Ações" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✏" Tag="{Binding}" Click="OnEditClick"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#78909C" Padding="4,2" FontSize="13"/>
                                    <Button Content="🗑" Tag="{Binding}" Click="OnDeleteClick"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#EF5350" Padding="4,2" FontSize="13"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Status -->
        <Border Grid.Row="3" Background="#0D1117" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtStatus" Foreground="#546E7A" FontSize="11" VerticalAlignment="Center"
                           Text="🔒 Dados criptografados com AES-256. Vinculados a este computador."/>
            </StackPanel>
        </Border>
    </Grid>
</Window>


