<Window x:Class="KitTecnicoPro.Views.OptimizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:KitTecnicoPro.Converters"
        Title="🔧 Otimização do Windows"
        Width="600" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0D1117">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Background="#0D1117" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="🔧 Otimização do Windows" FontSize="16" FontWeight="Bold"
                       Foreground="#90CAF9"/>
            <TextBlock Text="Selecione os tweaks a aplicar. Ações reversíveis não prejudicam o sistema."
                       FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Lista de tweaks -->
        <Border Grid.Row="1" Background="#111927" BorderBrush="#1F2A3C" BorderThickness="1" CornerRadius="8" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TweaksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#151F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="2,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#ECEFF1">
                                            <Run Text="{Binding Icone}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Nome}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Descricao}" FontSize="11"
                                                   Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="8,3"
                                            Background="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsRisky, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="⚠ Atenção" FontSize="10"
                                                   Foreground="#FCA5A5" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Log de saída -->
        <Border Grid.Row="2" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8"
                Margin="0,10,0,0" Height="110">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="LogOutput"
                         Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11"
                         Foreground="#90CAF9" IsReadOnly="True"
                         TextWrapping="Wrap" AcceptsReturn="True"/>
            </ScrollViewer>
        </Border>

        <!-- Botões -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="☑ Selecionar Todos" Click="OnSelectAllClick"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#90A4AE" Margin="0,0,4,0"/>
            <Button Content="☐ Desmarcar Todos" Click="OnDeselectAllClick"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#90A4AE" Margin="0,0,8,0"/>
            <Button x:Name="BtnRun" Content="▶ Aplicar Selecionados" Click="OnRunClick"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#15803D" BorderBrush="#16A34A" Foreground="White" Margin="0,0,8,0"/>
            <Button Content="Fechar" IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#90A4AE"/>
        </StackPanel>
    </Grid>
</Window>
