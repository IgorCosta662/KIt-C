<Window x:Class="KitTecnicoPro.Views.FileHasherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🔑 Calculadora de Hashes"
        Height="580" Width="820"
        MinHeight="460" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"

        Background="#0D1117"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">



    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="🔑 Calculadora de Hashes de Arquivo"
                       FontSize="16" FontWeight="Bold" Foreground="#90CAF9"/>
            <TextBlock Text="Arraste arquivos para cá ou use o botão Procurar. Suporta múltiplos arquivos."
                       FontSize="11" Foreground="#546E7A" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Seleção de arquivo -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="#0D1117" CornerRadius="6" Padding="10,8"
                    AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
                <TextBlock x:Name="TxtArquivo" Text="Arraste um arquivo aqui ou clique em 📂 Procurar"
                           Foreground="#546E7A" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
            <Button Grid.Column="1" Content="📂 Procurar" Click="OnBrowseClick"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#0D1117" BorderBrush="#1565C0"
                    Padding="12,8" Margin="8,0"/>
            <Button Grid.Column="2" Content="🗑 Limpar" Click="OnClearClick"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#546E7A" Padding="10,8"/>
        </Grid>

        <!-- Resultados dos hashes -->
        <Border Grid.Row="2" Background="#0D1117" CornerRadius="8" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelHashes"/>
            </ScrollViewer>
        </Border>

        <!-- Comparar hashes -->
        <Border Grid.Row="3" Background="#0D1117" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍 Comparar hash:" Foreground="#78909C" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="TxtCompare"
                         materialDesign:HintAssist.Hint="Cole o hash esperado para comparar..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#ECEFF1" FontSize="12"
                         TextChanged="OnCompareChanged"/>
                <TextBlock Grid.Column="2" x:Name="TxtCompareResult"
                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- Status / Progresso -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <ProgressBar x:Name="PrgBar" Height="6" Minimum="0" Maximum="100" Value="0"
                         Foreground="#1565C0" Background="#0D1117" Margin="0,0,0,6"/>
            <TextBlock x:Name="TxtStatus" Foreground="#546E7A" FontSize="11"
                       Text="Arraste um arquivo ou clique em 📂 Procurar"/>
        </StackPanel>
    </Grid>
</Window>


