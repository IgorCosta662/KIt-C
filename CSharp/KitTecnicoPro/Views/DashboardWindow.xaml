<Window x:Class="KitTecnicoPro.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:KitTecnicoPro.Converters"
        Title="Dashboard — Monitor do Sistema"
        Width="720" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"

        Background="#0D1117"
        Closed="Window_Closed">



    <Window.Resources>

        <converters:BoolToColorConverter x:Key="BoolToColor"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="📊 Dashboard — Monitor do Sistema" FontSize="18" FontWeight="Bold"
                           Foreground="#90CAF9"/>
                <TextBlock Text="{Binding OsName}" FontSize="11" Foreground="#546E7A" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="12" Padding="10,4" Margin="4,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#B71C1C"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasInternet}" Value="True">
                                    <Setter Property="Background" Value="#1B5E20"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="🌐 Offline"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasInternet}" Value="True">
                                        <Setter Property="Text" Value="🌐 Online"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Border CornerRadius="12" Padding="10,4" Margin="4,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E65100"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Background" Value="#1B5E20"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="🛡️ Limitado"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                        <Setter Property="Text" Value="🛡️ Admin"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Button Content="↻ Atualizar" Click="OnRefreshClick" Margin="8,0,0,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#90A4AE" BorderBrush="#37474F" Height="32"/>
            </StackPanel>
        </Grid>

        <!-- Sugestão de Perfil -->
        <Border Grid.Row="1" Background="#0D1117" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🧠" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Perfil Recomendado para este Hardware" FontSize="11"
                               Foreground="#78909C"/>
                    <TextBlock Text="{Binding SuggestedProfile}" FontSize="16"
                               FontWeight="Bold" Foreground="#90CAF9"/>
                    <TextBlock Text="{Binding SuggestedReason}" FontSize="11"
                               Foreground="#546E7A" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CPU + RAM -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CPU Card -->
            <Border Grid.Column="0" Background="#0D1117" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="🔧 Processador" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding CpuName}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#ECEFF1" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Uso Atual" FontSize="11" Foreground="#78909C"/>
                        <TextBlock Grid.Column="1" FontSize="14" FontWeight="Bold"
                                   Foreground="{Binding CpuColor}">
                            <Run Text="{Binding CpuUsage, StringFormat='{}{0:F0}'}"/><Run Text="%"/>
                        </TextBlock>
                    </Grid>
                    <ProgressBar Value="{Binding CpuUsage}" Maximum="100" Height="10"
                                 Foreground="{Binding CpuColor}"
                                 Background="#0D1117"/>
                </StackPanel>
            </Border>

            <!-- RAM Card -->
            <Border Grid.Column="2" Background="#0D1117" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="🧠 Memória RAM" FontSize="12" Foreground="#78909C" Margin="0,0,0,4"/>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#ECEFF1" Margin="0,0,0,10">
                        <Run Text="{Binding RamUsedGB, StringFormat='{}{0:F1}'}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding RamTotalGB, StringFormat='{}{0:F1}'}"/>
                        <Run Text=" GB"/>
                    </TextBlock>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Em uso" FontSize="11" Foreground="#78909C"/>
                        <TextBlock Grid.Column="1" FontSize="14" FontWeight="Bold"
                                   Foreground="{Binding RamColor}">
                            <Run Text="{Binding RamUsagePercent, StringFormat='{}{0:F0}'}"/><Run Text="%"/>
                        </TextBlock>
                    </Grid>
                    <ProgressBar Value="{Binding RamUsagePercent}" Maximum="100" Height="10"
                                 Foreground="{Binding RamColor}"
                                 Background="#0D1117"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Discos -->
        <Border Grid.Row="3" Background="#0D1117" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="💾 Discos" FontSize="12" Foreground="#78909C" Margin="0,0,0,10"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Disks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontSize="13"
                                           Foreground="#ECEFF1" FontWeight="SemiBold">
                                    <Run Text="💾 "/>
                                    <Run Text="{Binding Drive}"/>
                                </TextBlock>
                                <ProgressBar Grid.Column="1" Value="{Binding UsedPercent}"
                                             Maximum="100" Height="12" Margin="8,0"
                                             VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" FontSize="11" Foreground="#78909C"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding FreeGB, StringFormat='{}{0:F1}'}"/>
                                    <Run Text=" GB livre de "/>
                                    <Run Text="{Binding TotalGB, StringFormat='{}{0:F1}'}"/>
                                    <Run Text="GB"/>
                                </TextBlock>
                                <TextBlock Grid.Column="3" FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center" TextAlignment="Right"
                                           Foreground="#90CAF9">
                                    <Run Text="{Binding UsedPercent, StringFormat='{}{0:F0}'}"/>
                                    <Run Text="%"/>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="Atualiza a cada 3 segundos" FontSize="11" Foreground="#37474F"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Fechar" IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#90A4AE"/>
        </StackPanel>
    </Grid>
</Window>


