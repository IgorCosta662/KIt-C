<Window x:Class="KitTecnicoPro.Views.IsoManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:KitTecnicoPro.Converters"
        Title="💿 Gerenciador de ISOs" Height="700" Width="1160"
        MinHeight="500" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="#090D15">

    <Window.Resources>
        <converters:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Window.Resources>

    <Grid Background="#70090D15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <Border Grid.Row="0" Padding="20,14" materialDesign:ElevationAssist.Elevation="Dp2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F2027" Offset="0.0"/>
                    <GradientStop Color="#203A43" Offset="0.5"/>
                    <GradientStop Color="#2C5364" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="📁 Pasta ISOs"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#90CAF9" BorderBrush="#37474F"
                            Margin="0,0,8,0" Click="OnOpenFolderClick"/>
                    <Button Content="🔗 Adicionar ISO"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#A5D6A7" BorderBrush="#37474F"
                            Click="OnAddCustomIsoClick"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="💿 Gerenciador de ISOs" FontSize="19"
                               FontWeight="Bold" Foreground="#ECEFF1"/>
                    <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"
                               Text="Baixe e gerencie imagens de sistemas operacionais de forma rápida e centralizada"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Filtros ══ -->
        <Border Grid.Row="1" Background="#16213E" Padding="14,8">
            <DockPanel>
                <TextBlock x:Name="TxtContagem" DockPanel.Dock="Right"
                           Foreground="#94A3B8" VerticalAlignment="Center"
                           FontSize="12" Margin="0,0,4,0"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Categoria:" Foreground="#94A3B8" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbCategoria" Width="190"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Foreground="#ECEFF1"
                              SelectionChanged="OnCategoriaChanged">
                        <ComboBoxItem Content="Todos" IsSelected="True"/>
                        <ComboBoxItem Content="🪟 Windows"/>
                        <ComboBoxItem Content="🐧 Linux"/>
                        <ComboBoxItem Content="🐡 BSD"/>
                        <ComboBoxItem Content="🖥️ Outros"/>
                        <ComboBoxItem Content="🔧 Utilitários"/>
                    </ComboBox>
                    <TextBlock Text="💡 Clique em Baixar para download direto ou Site para abrir no navegador"
                               Foreground="#94A3B8" FontSize="11" Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Lista em Cards Modernos ══ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,5,0,0">
            <ItemsControl x:Name="LstIsos" Margin="10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- CARD -->
                        <Border Width="330" Height="130" Margin="10,10" CornerRadius="12" Background="#80111C2B" BorderBrush="#1E2C44" BorderThickness="1"
                                materialDesign:ElevationAssist.Elevation="Dp4">
                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Topo: Ícone, Nome, Status -->
                                <DockPanel Grid.Row="0" LastChildFill="False">
                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Background="#A00F172A" BorderBrush="#1E293B" BorderThickness="1"
                                            materialDesign:ElevationAssist.Elevation="Dp1">
                                        <TextBlock Text="{Binding CategoriaIcon, Mode=OneWay}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="Bold" Foreground="#F1F5F9"/>
                                        <TextBlock Text="{Binding Descricao}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,3" VerticalAlignment="Top" Background="{Binding StatusBrush, Mode=OneWay}">
                                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </DockPanel>

                                <!-- Info Tags -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="52,10,0,0" VerticalAlignment="Top">
                                    <Border CornerRadius="4" Background="#1E293B" Padding="6,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Versao}" FontSize="10" Foreground="#94A3B8"/>
                                    </Border>
                                    <Border CornerRadius="4" Background="#1E293B" Padding="6,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Arq}" FontSize="10" Foreground="#94A3B8"/>
                                    </Border>
                                    <Border CornerRadius="4" Background="#1E293B" Padding="6,2">
                                        <TextBlock Text="{Binding TamanhoTexto, Mode=OneWay}" FontSize="10" Foreground="#94A3B8"/>
                                    </Border>
                                </StackPanel>

                                <!-- Rodapé: Ações e Barra de Progresso -->
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <ProgressBar Value="{Binding Progresso, Mode=OneWay}" Minimum="0" Maximum="100" Height="4"
                                                 VerticalAlignment="Bottom" Margin="0,0,0,-8" Foreground="#3B82F6" Background="#1E293B" BorderThickness="0"
                                                 Visibility="{Binding IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Tag="{Binding}" Click="OnDownloadClick"
                                                Visibility="{Binding IsDirectLink, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Content="Baixar" Foreground="#60A5FA" BorderBrush="#1E3A8A" Padding="10,0" Height="26" FontSize="11" Margin="0,0,8,0"/>
                                        <Button Tag="{Binding}" Click="OnOpenSiteClick"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Content="Site" Foreground="#A78BFA" BorderBrush="#4C1D95" Padding="10,0" Height="26" FontSize="11" Margin="0,0,8,0"/>
                                        
                                        <Button Tag="{Binding}" Click="OnOpenFileClick"
                                                Visibility="{Binding IsDownloaded, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource MaterialDesignIconButton}" ToolTip="Abrir Pasta" Width="26" Height="26" Foreground="#34D399">
                                            <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14"/>
                                        </Button>
                                        <Button Tag="{Binding}" Click="OnClearClick"
                                                Visibility="{Binding IsDownloaded, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource MaterialDesignIconButton}" ToolTip="Remover Local" Width="26" Height="26" Foreground="#F87171">
                                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ══ Footer / Progress ══ -->
        <Border Grid.Row="3" Background="#0D1B2A" Padding="16,10">
            <DockPanel>
                <Button x:Name="BtnCancel" DockPanel.Dock="Right"
                        Content="⛔ Cancelar" Click="OnCancelClick"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#EF9A9A" BorderBrush="#37474F"
                        Visibility="Collapsed" Margin="12,0,0,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="✅ Pronto — selecione um ISO e clique em Baixar"
                               Foreground="#94A3B8" FontSize="12"/>
                    <ProgressBar x:Name="PrgGlobal" Height="5" Margin="0,5,0,0"
                                 Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
