<Window x:Class="KitTecnicoPro.Views.PluginsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Plugins / Scripts"
        Width="560" Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"

        Background="#0D1117">



    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="🔌 Plugins / Scripts PowerShell" FontSize="16" FontWeight="Bold"
                       Foreground="#90CAF9"/>
            <TextBlock FontSize="11" Foreground="#78909C" Margin="0,4,0,0"
                       Text="Coloque arquivos .ps1 na pasta /Plugins. Os scripts são validados antes da execução."/>
        </StackPanel>

        <Border Grid.Row="1" Background="#0D1117" CornerRadius="8" Padding="8">
            <ListBox x:Name="PluginList"
                     Background="#0D1117"
                     Style="{StaticResource MaterialDesignListBox}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,3">
                            <materialDesign:PackIcon Kind="ScriptText" Width="18" Height="18"
                                                     Foreground="#90CAF9" Margin="0,0,8,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding}" FontSize="13" Foreground="#ECEFF1"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="↻ Atualizar" Click="OnRefreshClick"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="#90A4AE" BorderBrush="#37474F" Margin="0,0,8,0"/>
            <Button Content="📂 Abrir pasta Plugins" Click="OnOpenFolderClick"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="#90CAF9" BorderBrush="#90CAF9" Margin="0,0,8,0"/>
            <Button Content="▶ Executar Selecionado" Click="OnRunClick"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#0D1117" BorderBrush="#1B5E20"/>
            <Button Content="Fechar" IsCancel="True" HorizontalAlignment="Right"
                    Margin="8,0,0,0"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#90A4AE"/>
        </StackPanel>
    </Grid>
</Window>


