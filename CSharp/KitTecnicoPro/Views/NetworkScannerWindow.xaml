<Window x:Class="KitTecnicoPro.Views.NetworkScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🌐 Scanner de Rede"
        Height="660" Width="980"
        MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"

        Background="#0D1117">



    <Grid Background="#0D1117">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#0D1117" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🌐 Scanner de Rede Local"
                               FontSize="16" FontWeight="Bold" Foreground="#ECEFF1"/>
                    <TextBlock FontSize="11" Foreground="#546E7A" Margin="0,3,0,0"
                               Text="Descobre dispositivos ativos na sua rede local via ping paralelo"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnScan" Content="🔍 Iniciar Scan" Click="OnScanClick"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#0D1117" BorderBrush="#1B5E20"
                            Padding="14,8" FontSize="13" Margin="0,0,8,0"/>
                    <Button Content="⛔ Parar" Click="OnStopClick"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#0D1117" BorderBrush="#B71C1C"
                            Padding="12,8" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Configurações -->
        <Border Grid.Row="1" Background="#0D1117" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sub-rede:" Foreground="#78909C" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtSubnet" Width="160" Text="192.168.1"
                         materialDesign:HintAssist.Hint="ex: 192.168.1"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#ECEFF1" FontSize="12" Margin="0,0,16,0"/>
                <TextBlock Text="Timeout (ms):" Foreground="#78909C" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbTimeout" Width="90" SelectedIndex="1"
                          Foreground="#ECEFF1" FontSize="12" Margin="0,0,16,0">
                    <ComboBoxItem Content="300"/>
                    <ComboBoxItem Content="500"/>
                    <ComboBoxItem Content="1000"/>
                    <ComboBoxItem Content="2000"/>
                </ComboBox>
                <TextBlock Text="Verificar portas:" Foreground="#78909C" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CheckBox x:Name="ChkPorts" IsChecked="False" Foreground="#ECEFF1" FontSize="12"
                          Content="80, 443, 3389, 22" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <ProgressBar x:Name="PrgScan" Width="200" Height="8" Minimum="0" Maximum="254" Value="0"
                             Foreground="#1565C0" Background="#0D1117" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtPct" Text="" Foreground="#78909C" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Resultado -->
        <ListView x:Name="LstHosts" Grid.Row="2"
                  Background="#0D1117" BorderBrush="#1E3A5F"
                  Foreground="#ECEFF1"
                  VirtualizingPanel.IsVirtualizing="True">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="36"/>
                    <Setter Property="Foreground" Value="#ECEFF1"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1565C0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1E3A5F"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="50">
                        <GridViewColumn.Header><TextBlock Text="" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusIcon}" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="140">
                        <GridViewColumn.Header><TextBlock Text="IP" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Ip}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#90CAF9" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="220">
                        <GridViewColumn.Header><TextBlock Text="Hostname" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Hostname}" FontSize="12"
                                           Foreground="#ECEFF1" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="210"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="90">
                        <GridViewColumn.Header><TextBlock Text="Ping (ms)" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PingMs}" FontSize="12"
                                           Foreground="{Binding PingColor}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="220">
                        <GridViewColumn.Header><TextBlock Text="Portas Abertas" Foreground="#78909C" FontSize="11"/></GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OpenPorts}" FontSize="11"
                                           Foreground="#A5D6A7" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Status -->
        <Border Grid.Row="3" Background="#0D1117" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtStatus" Foreground="#78909C" FontSize="11"
                           VerticalAlignment="Center" Text="Configure a sub-rede e clique em 🔍 Iniciar Scan"/>
                <TextBlock Text="   •   " Foreground="#37474F" FontSize="11" VerticalAlignment="Center"/>
                <Button Content="📋 Copiar Resultados" Click="OnCopyClick"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="#546E7A" Padding="6,2" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>


