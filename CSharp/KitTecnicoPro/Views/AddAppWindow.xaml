<Window x:Class="KitTecnicoPro.Views.AddAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Adicionar / Editar Programa"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"

        Background="#0D1117">



    <StackPanel Margin="24">
        <TextBlock Text="📦 Dados do Programa" FontSize="16" FontWeight="Bold"
                   Foreground="#90CAF9" Margin="0,0,0,20"/>

        <TextBox x:Name="TxtNome"
                 materialDesign:HintAssist.Hint="Nome do programa *"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Foreground="#ECEFF1" Margin="0,0,0,12"/>

        <TextBox x:Name="TxtId"
                 materialDesign:HintAssist.Hint="ID winget (ex: Google.Chrome)"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Foreground="#ECEFF1" Margin="0,0,0,12"/>

        <TextBox x:Name="TxtDescricao"
                 materialDesign:HintAssist.Hint="Descrição"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Foreground="#ECEFF1" Margin="0,0,0,12"/>

        <ComboBox x:Name="CmbCategoria"
                  materialDesign:HintAssist.Hint="Categoria"
                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                  Foreground="#ECEFF1" Margin="0,0,0,12">
            <ComboBoxItem>Navegadores</ComboBoxItem>
            <ComboBoxItem>Segurança</ComboBoxItem>
            <ComboBoxItem>Utilitários</ComboBoxItem>
            <ComboBoxItem>Comunicação</ComboBoxItem>
            <ComboBoxItem>Multimídia</ComboBoxItem>
            <ComboBoxItem>Desenvolvimento</ComboBoxItem>
            <ComboBoxItem>Games</ComboBoxItem>
            <ComboBoxItem>Office</ComboBoxItem>
            <ComboBoxItem>Compactadores</ComboBoxItem>
            <ComboBoxItem>Drivers</ComboBoxItem>
            <ComboBoxItem>Limpeza</ComboBoxItem>
            <ComboBoxItem>Geral</ComboBoxItem>
        </ComboBox>

        <ComboBox x:Name="CmbTipo"
                  materialDesign:HintAssist.Hint="Tipo de instalação"
                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                  Foreground="#ECEFF1" Margin="0,0,0,12"
                  SelectionChanged="CmbTipo_SelectionChanged">
            <ComboBoxItem Tag="winget">winget</ComboBoxItem>
            <ComboBoxItem Tag="custom">custom (URL)</ComboBoxItem>
            <ComboBoxItem Tag="local">local (setup.exe)</ComboBoxItem>
        </ComboBox>

        <!-- Painel: custom (URL) -->
        <StackPanel x:Name="PanelCustom" Visibility="Collapsed">
            <TextBox x:Name="TxtUrl"
                     materialDesign:HintAssist.Hint="URL do instalador"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Foreground="#ECEFF1" Margin="0,0,0,12"/>

            <TextBox x:Name="TxtSilentArgs"
                     materialDesign:HintAssist.Hint="Argumentos silenciosos (ex: /S /quiet)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Foreground="#ECEFF1" Margin="0,0,0,12"/>
        </StackPanel>

        <!-- Painel: local (setup.exe) -->
        <StackPanel x:Name="PanelLocal" Visibility="Collapsed">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtLocalPath"
                         materialDesign:HintAssist.Hint="Caminho do instalador (.exe / .msi)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Foreground="#ECEFF1" IsReadOnly="True"/>
                <Button Grid.Column="1" Content="📂 Procurar"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#90CAF9" BorderBrush="#37474F"
                        Margin="8,0,0,0" Height="56"
                        Click="OnBrowseLocalClick"/>
            </Grid>
            <TextBox x:Name="TxtLocalSilentArgs"
                     materialDesign:HintAssist.Hint="Argumentos silenciosos (ex: /S /silent /quiet)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Foreground="#ECEFF1" Margin="0,0,0,12"
                     Text="/S"/>
            <Border Background="#0D1117" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                <TextBlock FontSize="11" Foreground="#78909C" TextWrapping="Wrap">
                    <Run Text="💡 "/>
                    <Run Text="Dica: argumentos comuns — "/>
                    <Run Text="/S" Foreground="#90CAF9"/>
                    <Run Text=" (NSIS)  "/>
                    <Run Text="/silent" Foreground="#90CAF9"/>
                    <Run Text=" (Inno)  "/>
                    <Run Text="/quiet" Foreground="#90CAF9"/>
                    <Run Text=" (MSI/outros)"/>
                </TextBlock>
            </Border>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#90A4AE"/>
            <Button Content="Salvar" IsDefault="True" Click="OnSaveClick"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#0D1117" BorderBrush="#1565C0"/>
        </StackPanel>
    </StackPanel>
</Window>


